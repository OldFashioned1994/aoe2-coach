data/builds/

# destilados del .dat del juego (contenido de Microsoft): los genera `ingest --solo dat`
data/ref/gather_rates.json
data/ref/tech_effects_eco.json

# builds propios (si comprás una guía, va acá y no se sube)
data/builds/propios/
