# entorno
.venv/
__pycache__/
*.pyc
.pytest_cache/

# datos descargados y regenerables (no se redistribuyen)
data/raw/
data/*.duckdb

# build orders de rtsbuilds (GPL-3.0): los baja `ingest --solo builds`,
